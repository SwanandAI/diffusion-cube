# Diffusion Cube — environment variables
# Copy to .env.local for local development and fill in real values.
# Never commit .env.local. Set the same names in Vercel (or the Docker env
# file) for each environment. See docs/wiki/diffusion-cube/architecture/configuration.md.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# Server only — bypasses RLS. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Not read by the app — used to run migrations with psql (supabase/migrations/).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=<anthropic-api-key>

# --- Admin access ---
# Comma-separated emails treated as admin (in addition to the admin role).
ADMIN_EMAILS=admin@example.com

# --- Email (Supabase Send Email hook + notifications) ---
SEND_EMAIL_HOOK_SECRET=<v1,whsec_...>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
EMAIL_FROM_ADDRESS="Diffusion Cube <no-reply@example.com>"
# Optional — default: true only when SMTP_PORT=465.
# SMTP_SECURE=true

# --- GitHub (contributor "Send for Review" commits pathway documents) ---
GITHUB_TOKEN=<github-token-with-contents-write>
GITHUB_REPO=<owner>/<repo>
# Default: pathways-dev. Do NOT use main — a commit there triggers a deploy.
GITHUB_BRANCH=pathways-dev

# --- Monitoring, logging and rate limiting ---
# Environment tag on sys_errors rows: prod | dev. If unset, Vercel's
# VERCEL_ENV decides (production -> prod, anything else -> dev). Set it to
# prod explicitly on the Docker/AWS deployment.
APP_ENV=dev
# Salt for hashing visitor IPs in the rate limiter. Random, different per
# environment: openssl rand -hex 32
RATE_LIMIT_SALT=<64-hex-chars>
# Per-IP limits for anonymous /api/chat calls (the public Explore chat),
# /api/errors/client, and recording anonymous 4xx errors in sys_errors
# (each counted separately). Defaults: 20 per minute, 200 per day.
EXPLORE_RATE_LIMIT_PER_MIN=20
EXPLORE_RATE_LIMIT_PER_DAY=200
# Per-account limits for signed-in /api/chat calls, every mode.
# Defaults: 30 per minute, 300 per day.
CHAT_USER_RATE_LIMIT_PER_MIN=30
CHAT_USER_RATE_LIMIT_PER_DAY=300
# Explore chat input caps, checked on every library request. Cube's replies
# count towards the message and total limits; the per-message cap applies
# only to the visitor's own messages. Defaults: 20 / 1000 / 20000.
EXPLORE_MAX_MESSAGES=20
EXPLORE_MAX_USER_MESSAGE_CHARS=1000
EXPLORE_MAX_TOTAL_CHARS=20000

# --- Optional ---
# Contact shown on the Terms/Privacy pages. Default: kamesh@ekstep.org
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Overrides the pathway corpus location (default: content/wiki). Leave it
# unset — an empty value (WIKI_PATH=) disables the static corpus.
# WIKI_PATH=/absolute/path/to/content/wiki
